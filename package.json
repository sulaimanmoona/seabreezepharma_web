{
  "name": "seabreeze-pharma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-zxing-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-zxing-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:init": "wrangler d1 execute seabreezepharma --local --file=db/schema.sql && wrangler d1 execute seabreezepharma --local --file=db/seed.sql",
    "db:init:remote": "wrangler d1 execute seabreezepharma --remote --file=db/schema.sql && wrangler d1 execute seabreezepharma --remote --file=db/seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "barcode-detector": "^3.2.3",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.160.1"
  }
}
